# Copiar a .env y completar. El .env está en .gitignore y nunca se sube al repositorio.

# --- Proveedor del LLM ---------------------------------------------------------------
# Opciones: openai | anthropic | gemini | ollama
# Solo hace falta la API key del proveedor elegido, y su paquete de LangChain
# (requirements.txt trae el de gemini; los otros tres están comentados ahí).
LLM_PROVIDER=gemini

# --- API keys (completar solo la del proveedor elegido) -------------------------------
# gemini — gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# openai — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ollama corre local y no lleva API key.

# --- Modelo de cada proveedor ---------------------------------------------------------
# Cada uno tiene su propia variable a propósito: así cambiar LLM_PROVIDER no obliga a
# cambiar también el modelo. Si se dejan vacías, el código usa estos mismos valores.

# flash-lite porque la capa gratuita le da 15 pedidos por minuto (contra 5 de
# gemini-flash-latest) y una corrida completa de main.py hace 8 llamadas al LLM.
MODELO_GEMINI=gemini-flash-lite-latest

MODELO_OPENAI=gpt-4o-mini
MODELO_ANTHROPIC=claude-haiku-4-5

# El modelo de Ollama tiene que soportar tool calling (llama3.1, qwen3, mistral-nemo…);
# uno que no lo soporte nunca va a emitir tool_calls y el ciclo ReAct no arranca.
MODELO_OLLAMA=llama3.1

# Servidor de Ollama, por si no corre en localhost.
OLLAMA_BASE_URL=http://localhost:11434
