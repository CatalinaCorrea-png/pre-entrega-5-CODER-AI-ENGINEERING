# Copiar a .env y completar. El .env está en .gitignore y nunca se sube al repositorio.

# LLM — clave gratuita en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Modelo de Gemini que usa el nodo 'modelo' del grafo.
# flash-lite porque la capa gratuita le da 15 pedidos por minuto (contra 5 de
# gemini-flash-latest) y una corrida completa de main.py hace 8 llamadas al LLM.
MODELO_LLM=gemini-flash-lite-latest
